{
  "translatable_fields": {
    "description": "Field map consumed by hydrate-13 (overlay generation) and mai_translate:hydrate-overlays. `fields` = translate; `copy_fields` = copy 1:1 from DE; `fal` = extra sys_file_reference specs. The hydrate command also reads TCA type=file columns of these tables, so a new file field does not need a manual fal entry. `regenerate_slug` = SlugHelper after translation. Excludes proper nouns from fields.",
    "consumers": [
      "scripts/hydration/generate-translation-overlays.py",
      "packages/typo3-extension-translate/Classes/Command/HydrateTranslationsCommand.php"
    ],
    "language_uid_map": {
      "1": "en",
      "2": "uk",
      "3": "ar"
    },
    "overlay_uid_offsets": {
      "description": "Offsets added to the default-language source UID to derive overlay UIDs. Keep per-table offset > observed max source UID to avoid collisions.",
      "pages": {
        "1": 100,
        "2": 200,
        "3": 300
      },
      "tt_content": {
        "1": 10000,
        "2": 20000,
        "3": 30000
      },
      "domain_records": {
        "1": 1000,
        "2": 2000,
        "3": 3000
      }
    },
    "tables": {
      "pages": {
        "fields": [
          "title",
          "nav_title",
          "subtitle",
          "abstract",
          "tx_maievents_location",
          "tx_mainews_teaser",
          "tx_maimember_position"
        ],
        "copy_fields": [
          "pid",
          "doktype",
          "sorting",
          "hidden",
          "nav_hide",
          "is_siteroot",
          "backend_layout",
          "backend_layout_next_level",
          "media",
          "module",
          "tx_maievents_start_date",
          "tx_maievents_end_date",
          "tx_maievents_recurrence_frequency",
          "tx_maievents_recurrence_until",
          "tx_maievents_recurrence_month_weekday",
          "tx_mainews_date",
          "tx_maimember_first_name",
          "tx_maimember_last_name",
          "tx_maimember_email",
          "tx_maimember_phone",
          "tx_maimember_status",
          "tx_maimember_join_date",
          "tx_maimember_fe_user"
        ],
        "parent_field": "l10n_parent",
        "uid_offset_key": "pages",
        "regenerate_slug": true,
        "fal": [
          {
            "fieldname": "tx_maimember_image",
            "count_field": "tx_maimember_image"
          },
          {
            "fieldname": "tx_mainews_images",
            "count_field": "tx_mainews_images"
          },
          {
            "fieldname": "tx_maiseo_og_image",
            "count_field": "tx_maiseo_og_image"
          }
        ],
        "notes": "Titles, abstracts, news teasers, event locations and member roles are translated. Event dates, news dates and member names are copied. Slugs via SlugHelper."
      },
      "tt_content": {
        "fields": [
          "header",
          "subheader",
          "bodytext",
          "tx_maitheme_link_text",
          "tx_maitheme_link_secondary_text",
          "tx_maitheme_eyebrow",
          "tx_maitheme_badge_text"
        ],
        "copy_fields": [
          "pid",
          "sorting",
          "hidden",
          "CType",
          "colPos",
          "layout",
          "frame_class",
          "space_before_class",
          "space_after_class",
          "header_layout",
          "header_position",
          "date",
          "imagecols",
          "imageorient",
          "imagewidth",
          "imageheight",
          "imageborder",
          "list_type",
          "pages",
